# CloudSentinel Backend Configuration
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins (strict exact origin, no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Persistence:
# Leave commented to use local SQLite (backend/data/cloudsentinel.db)
# Or provide Neon PostgreSQL connection string for production:
# DATABASE_URL=postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: SQLite Database Path override (when DATABASE_URL is not set)
# SQLITE_DB_PATH=backend/data/cloudsentinel.db

# Agent Ingestion Security:
# Secret token required by the Ubuntu monitoring agent in X-Agent-Token header
AGENT_API_KEY=cloudsentinel-insecure-dev-token

# Dashboard & API Protection:
# Secret API key required by frontend/operators in X-API-Key header to view metrics, alerts, and security logs
# (Leave empty in local development to permit unrestricted localhost access)
# DASHBOARD_API_KEY=your-secure-dashboard-api-key

# Optional: Authentication Log Source (for local fallback collector)
# AUTH_LOG_PATH=/var/log/auth.log

# Optional: Monitored Disk Mount Point (defaults to host root mount)
# DISK_MONITOR_PATH=/

# Optional: Resource Alert Thresholds
# CPU_WARNING_THRESHOLD=75.0
# CPU_CRITICAL_THRESHOLD=90.0
# MEMORY_WARNING_THRESHOLD=80.0
# MEMORY_CRITICAL_THRESHOLD=92.0
# DISK_WARNING_THRESHOLD=75.0
# DISK_CRITICAL_THRESHOLD=90.0

# Optional: Security Correlation Window
# SSH_REPEATED_ATTEMPTS_THRESHOLD=5
# SSH_WINDOW_SECONDS=300
