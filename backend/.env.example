# CloudSentinel Backend Configuration
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins for development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: SQLite Database Path (defaults to backend/data/cloudsentinel.db)
# SQLITE_DB_PATH=backend/data/cloudsentinel.db

# Optional: Authentication Log Source (defaults to /var/log/auth.log)
# AUTH_LOG_PATH=/var/log/auth.log

# Optional: Monitored Disk Mount Point (defaults to host root mount)
# DISK_MONITOR_PATH=/

# Optional: Resource Alert Thresholds
# CPU_WARNING_THRESHOLD=75.0
# CPU_CRITICAL_THRESHOLD=90.0
# MEMORY_WARNING_THRESHOLD=80.0
# MEMORY_CRITICAL_THRESHOLD=92.0
# DISK_WARNING_THRESHOLD=75.0
# DISK_CRITICAL_THRESHOLD=90.0

# Optional: Security Correlation Window
# SSH_REPEATED_ATTEMPTS_THRESHOLD=5
# SSH_WINDOW_SECONDS=300
