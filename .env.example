# CloudSentinel Frontend Configuration
# Base URL of the FastAPI backend service (e.g. local or Render deployment)
# Local development:
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Production Render deployment:
VITE_API_BASE_URL=https://cloudsentinel-backend-a76u.onrender.com

# Dashboard API access key (matches DASHBOARD_API_KEY configured on the backend)
VITE_API_KEY=your-secure-dashboard-api-key
