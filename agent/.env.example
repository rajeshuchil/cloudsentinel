# CloudSentinel Ubuntu Agent Configuration

# Render backend URL (or local http://127.0.0.1:8000 for testing)
BACKEND_URL=https://cloudsentinel-backend.onrender.com

# Device Authentication Token (must match AGENT_API_KEY in Render backend)
AGENT_TOKEN=your-secure-agent-token-here

# Telemetry transmission interval in seconds (default: 30 for Neon compute optimization)
TELEMETRY_INTERVAL=30

# Path to system authentication log (default: /var/log/auth.log)
AUTH_LOG_PATH=/var/log/auth.log

# Optional: Override auto-detected device identifier
# AGENT_DEVICE_ID=ubuntu-laptop-primary

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
